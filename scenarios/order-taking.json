      "tier": 1,
      "tags": [
        "order",
        "slot-fill",
        "create"
      ],
      "voice": "en-US-AriaNeural",
      "rate": "+0%",
      "pitch": "+0Hz",
      "pause_ms": 500,
      "turns": [
        {
          "speak": "I'd like to order a coffee",
          "expect": {
            "event": "agent_action",
            "contains": "what size",
            "within_ms": 5000
          }
        },
        {
          "speak": "large please",
          "expect": {
